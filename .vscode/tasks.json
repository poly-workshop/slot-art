{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build-frontend",
      "type": "shell",
      "command": "pnpm",
      "args": ["build"],
      "options": {
        "cwd": "${workspaceFolder}/website"
      },
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "start-redis",
      "type": "shell",
      "command": "docker",
      "args": ["compose", "up", "-d", "redis"],
      "group": "build",
      "problemMatcher": []
    }
  ]
}
